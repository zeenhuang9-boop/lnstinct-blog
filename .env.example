# 站点公开 URL（本地验收可留空，默认 http://localhost:3000）
NEXT_PUBLIC_SITE_URL=

# 可选：配置后公共站数据走 Supabase（否则使用本地 data/ 文件存储）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端后台写操作密钥（仅服务器端使用，绝不暴露到浏览器；未配置时后台回退本地文件存储）
SUPABASE_SERVICE_ROLE_KEY=

# 后台管理员密码与会话签名密钥（本地验收未配置时使用文档化的默认值）
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
